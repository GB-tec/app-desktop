{
  "name": "gbsoft-desktop",
  "version": "1.0.0",
  "description": "Sistema de gestão fiscal desktop",
  "main": "main.js",
  "homepage": "https://github.com/netwhork/GB-SOFT",
  "repository": {
    "type": "git",
    "url": "https://github.com/netwhork/GB-SOFT.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "SET NODE_ENV=development && electron .",
    "build": "electron-builder -w --x64 -c.target=[\"nsis\",\"portable\"]",
    "build:portable": "electron-builder -w --x64 -c.target=portable",
    "build:installer": "electron-builder -w --x64 -c.target=nsis",
    "pack": "electron-builder --dir",
    "dist": "electron-builder -w",
    "publish": "electron-builder -w --publish=always",
    "clean": "rmdir /s /q dist",
    "rebuild": "npm run clean && npm run build",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "GbSoft",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "electron-reload": "^2.0.0",
    "nodemon": "^2.0.22"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "firebase-admin": "^11.11.0",
    "playwright": "^1.55.0",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1",
    "electron-updater": "^6.1.7"
  },
  "build": {
    "appId": "com.gbsoft.desktop",
    "productName": "GbSoft Desktop",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "compression": "maximum",
    "files": [
      "**/*",
      "!node_modules/.bin/*",
      "!node_modules/*/test/*",
      "!node_modules/*/docs/*",
      "!node_modules/*/examples/*",
      "!**/*.map",
      "!**/*.md"
    ],
    "publish": {
      "provider": "github",
      "owner": "netwhork",
      "repo": "GB-SOFT",
      "private": false,
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "publisherName": "GbSoft"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GbSoft Desktop",
      "installerHeaderIcon": "assets/icon.ico",
      "menuCategory": true,
      "runAfterFinish": true,
      "differentialPackage": true
    },
    "portable": {
      "artifactName": "GbSoft-Desktop-Portable.exe"
    },
    "asar": true
  }
}
